# ─── Hostinger Production Configuration ──────────────────────────────────────────
APP_NAME=WebIntoApp
APP_ENV=production
APP_KEY=base64:I8vCMc2mqH3FU6cKhL35CpQ8+0eXHNE3oXxuW6ZrC0Q=
APP_DEBUG=false
APP_URL=https://api.livaan.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ─── CORS & Frontend Domain ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://livaan.in,https://app.livaan.in,https://web-to-app.vercel.app,http://localhost:3000

# ─── Database (SQLite on Hostinger) ───────────────────────────────────────────────
# Keep DB_DATABASE blank so Laravel automatically uses the Linux path to database/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=

# ─── Cache / Queue / Session ──────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# ─── Mail (Brevo SMTP Relay) ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=c44600001@smtp-brevo.com
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="seo.vibesoft@gmail.com"
MAIL_FROM_NAME="WebIntoApp"

# ─── Sanctum ──────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=livaan.in,api.livaan.in,web-to-app.vercel.app,localhost:3000

# ─── Filament Admin ───────────────────────────────────────────────────────────────
FILAMENT_AUTH_GUARD=web

# ─── Logging ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error

# ─── Security Encryption Keys ─────────────────────────────────────────────────────
CREDENTIAL_VAULT_KEY=a7d2b4f9e1c385629471abdc9382f6e5a7d2b4f9e1c385629471abdc9382f6e5
OTP_PROVIDER=log
FILESYSTEM_DISK=public

# ─── Build Worker ─────────────────────────────────────────────────────────────────
BUILD_WORKER_TYPE=local
BUILD_TIMEOUT_SECONDS=1800
BUILD_CONCURRENCY_PER_TENANT=1

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_SnbtbVtFnRIrAI
