# ─── Hostinger Production Configuration ──────────────────────────────────────────
APP_NAME=WebIntoApp
APP_ENV=production
APP_KEY=base64:bkYf1uMJCqU8R844ds+oYO3wl+CyOMaeQ+Ylp1pIzIU=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ─── CORS & Frontend Domain ───────────────────────────────────────────────────────
# Enter your dashboard domain (e.g. https://yourdomain.com,https://app.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,http://localhost:3000

# ─── Database (Hostinger MySQL) ───────────────────────────────────────────────────
# Create database in Hostinger hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_webtoapp
DB_USERNAME=u123456789_user
DB_PASSWORD=your_strong_mysql_password

# If you prefer SQLite on Hostinger instead of MySQL, uncomment these 2 lines:
# DB_CONNECTION=sqlite
# DB_DATABASE=/home/u123456789/domains/yourdomain.com/public_html/backend/database/database.sqlite

# ─── Cache / Queue / Session ──────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# ─── Mail ─────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum ──────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,api.yourdomain.com,app.yourdomain.com

# ─── Filament Admin ───────────────────────────────────────────────────────────────
FILAMENT_AUTH_GUARD=web

# ─── Logging ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error

# ─── Security Encryption Keys ─────────────────────────────────────────────────────
CREDENTIAL_VAULT_KEY=a7d2b4f9e1c385629471abdc9382f6e5a7d2b4f9e1c385629471abdc9382f6e5
OTP_PROVIDER=log
FILESYSTEM_DISK=public

# ─── Build Worker ─────────────────────────────────────────────────────────────────
BUILD_WORKER_TYPE=local
BUILD_TIMEOUT_SECONDS=1800
BUILD_CONCURRENCY_PER_TENANT=1

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_SnbtbVtFnRIrAI
RAZORPAY_KEY_SECRET=Y5qIsn5hB5jZ9WJMwptQfVDS
RAZORPAY_WEBHOOK_SECRET=rzp_sec_test_secret_key_12345
